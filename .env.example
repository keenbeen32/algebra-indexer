# ---------------------------------------------------------------------------
# pumex-algebra-envio
#
# Copy to `.env` and fill in real values. Envio requires the `ENVIO_` prefix on
# anything read at runtime by the indexer or exposed on the hosted service.
# ---------------------------------------------------------------------------

# HyperSync access. Create one at https://envio.dev/app/api-tokens
ENVIO_API_TOKEN="<YOUR-API-TOKEN>"

# ---------------------------------------------------------------------------
# RPC endpoints — one per chain, named `ENVIO_RPC_URL_<chainId>`
#
# Contract reads are pinned to the block of the event that triggered them, so
# these should be archive endpoints; a pruned node answers from a later state
# rather than failing.
# ---------------------------------------------------------------------------

# Linea (59144) — contract reads.
ENVIO_RPC_URL_59144="<LINEA-ARCHIVE-RPC>"

# Zircuit (48900) — BOTH the log sync and contract reads, so it needs complete
# log history as well as archive state. There is deliberately no default: an
# unset value fails loudly. See the chain notes in the README.
ENVIO_RPC_URL_48900="<ZIRCUIT-ARCHIVE-RPC>"

# ---------------------------------------------------------------------------
# Optional second endpoints, tried after the primary's retries are exhausted.
# These are genuine alternate providers, not copies of the primary — retrying
# the primary only rescues a transient failure. Leave unset to skip failover.
# ---------------------------------------------------------------------------

ENVIO_RPC_URL_59144_FALLBACK=""
ENVIO_RPC_URL_48900_FALLBACK=""

# ---------------------------------------------------------------------------
# Optional tuning
# ---------------------------------------------------------------------------

# Per-effect RPC rate limit. Lower it if the provider returns 429s — the symptom
# is the indexer stalling with retry/timeout errors rather than crashing.
# ENVIO_EFFECT_RATE_LIMIT=500
